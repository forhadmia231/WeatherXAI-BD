2_score\nfrom scipy.stats import ttest_rel\n\n# ============================================================\n# 1. Directories\n# ============================================================\n\nOUT_DIR = \"/kaggle/working/WeatherXAI_BD_Publication_Output\"\nFIG_DIR = f\"{OUT_DIR}/figures\"\nTABLE_DIR = f\"{OUT_DIR}/tables\"\n\nos.makedirs(FIG_DIR, exist_ok=True)\nos.makedirs(TABLE_DIR, exist_ok=True)\n\n# ============================================================\n# 2. Prediction and Metrics\n# ============================================================\n\ny_test_inv = target_scaler.inverse_transform(y_test)\n\npredictions = {}\nresults = []\n\nfor model_name, model in models.items():\n\n    print(f\"Predicting with {model_name}...\")\n\n    pred_scaled = model.predict(X_test)\n    pred_inv = target_scaler.inverse_transform(pred_scaled)\n\n    predictions[model_name] = pred_inv\n\n    for i, var in enumerate(target_cols):\n\n        mae = mean_absolute_error(y_test_inv[:, i], pred_inv[:, i])\n        mse = mean_squared_error(y_test_inv[:, i], pred_inv[:, i])\n        rmse = np.sqrt(mse)\n        r2 = r2_score(y_test_inv[:, i], pred_inv[:, i])\n\n        results.append({\n            \"Model\": model_name,\n            \"Variable\": var,\n            \"MAE\": mae,\n            \"MSE\": mse,\n            \"RMSE\": rmse,\n            \"R2\": r2\n        })\n\nmetrics_df = pd.DataFrame(results)\nmetrics_df.to_csv(f\"{TABLE_DIR}/Table_4_5_Overall_Model_Comparison.csv\", index=False)\n\nprint(\"\\n================ METRICS RESULT ================\\n\")\nprint(metrics_df)\n\n# ============================================================\n# 3. Variable-wise Result Tables\n# ============================================================\n\nvariable_table_map = {\n    \"TEMPERATURE\": \"Table_4_1_Temperature_Forecasting_Performance.csv\",\n    \"HUMIDITY\": \"Table_4_2_Humidity_Forecasting_Performance.csv\",\n    \"WIND_SPEED\": \"Table_4_3_Wind_Speed_Forecasting_Performance.csv\",\n    \"PRECIPITATION\": \"Table_4_4_Precipitation_Forecasting_Performance.csv\"\n}\n\nfor var, filename in variable_table_map.items():\n    temp_df = metrics_df[metrics_df[\"Variable\"] == var]\n    temp_df.to_csv(f\"{TABLE_DIR}/{filename}\", index=False)\n\n# ============================================================\n# 4. Average R2 Table\n# ============================================================\n\navg_r2 = metrics_df.groupby(\"Model\")[\"R2\"].mean().reset_index()\navg_r2.columns = [\"Model\", \"Average_R2\"]\navg_r2 = avg_r2.sort_values(\"Average_R2\", ascending=False)\n\navg_r2.to_csv(f\"{TABLE_DIR}/Average_R2_by_Model.csv\", index=False)\n\nprint(\"\\n================ AVERAGE R2 ================\\n\")\nprint(avg_r2)\n\nbest_model_name = avg_r2.iloc[0][\"Model\"]\nbest_pred = predictions[best_model_name]\n\nprint(\"\\nBest Model:\", best_model_name)\n\n# ============================================================\n# 5. Actual vs Predicted Figures 4.1–4.12\n# ============================================================\n\nsample_n = min(500, len(y_test_inv))\n\nfigure_counter = {\n    \"LSTM\": 1,\n    \"Transformer\": 5,\n    \"Hybrid_LSTM_Transformer\": 9\n}\n\nfor model_name, pred_inv in predictions.items():\n\n    start_fig = figure_counter[model_name]\n\n    for i, var in enumerate(target_cols):\n\n        fig_no = start_fig + i\n\n        plt.figure(figsize=(12, 5))\n        plt.plot(y_test_inv[:sample_n, i], label=\"Actual\")\n        plt.plot(pred_inv[:sample_n, i], label=\"Predicted\")\n\n        title_var = var.replace(\"_\", \" \").title()\n        model_title = model_name.replace(\"_\", \" \")\n\n        plt.title(f\"Figure 4.{fig_no}: Actual vs Predicted {title_var} using {model_title}\")\n        plt.xlabel(\"Test Sample\")\n        plt.ylabel(title_var)\n        plt.legend()\n        plt.tight_layout()\n\n        filename = f\"Figure_4_{fig_no}_Actual_vs_Predicted_{var}_using_{model_name}.png\"\n        plt.savefig(f\"{FIG_DIR}/{filename}\", dpi=300)\n        plt.show()\n\n# ============================================================\n# 6. Comparative MAE, RMSE, R2 Figures 4.13–4.15\n# ============================================================\n\ncomparison_figures = {\n    \"MAE\": \"Figure_4_13_Comparative_MAE_Analysis.png\",\n    \"RMSE\": \"Figure_4_14_Comparative_RMSE_Analysis.png\",\n    \"R2\": \"Figure_4_15_Comparative_R2_Score_Analysis.png\"\n}\n\nfor metric, filename in comparison_figures.items():\n\n    pivot = metrics_df.pivot(index=\"Variable\", columns=\"Model\", values=metric)\n\n    plt.figure(figsize=(10, 6))\n    pivot.plot(kind=\"bar\", figsize=(10, 6))\n\n    plt.title(filename.replace(\"_\", \" \").replace(\".png\", \"\"))\n    plt.xlabel(\"Weather Variable\")\n    plt.ylabel(metric)\n    plt.xticks(rotation=20)\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/{filename}\", dpi=300)\n    plt.show()\n\n# ============================================================\n# 7. Training Time Figure 4.16\n# ============================================================\n\ntraining_time_path = f\"{TABLE_DIR}/Training_Time.csv\"\n\nif os.path.exists(training_time_path):\n    training_time_df = pd.read_csv(training_time_path)\n\n    plt.figure(figsize=(8, 5))\n    plt.bar(training_time_df[\"Model\"], training_time_df[\"Training_Time_Seconds\"])\n    plt.title(\"Figure 4.16 Model Training Time Comparison\")\n    plt.xlabel(\"Model\")\n    plt.ylabel(\"Training Time (Seconds)\")\n    plt.xticks(rotation=20)\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/Figure_4_16_Model_Training_Time_Comparison.png\", dpi=300)\n    plt.show()\n\n# ============================================================\n# 8. Hybrid Residual Analysis Figure 4.17\n# ============================================================\n\nresiduals = y_test_inv - best_pred\n\nplt.figure(figsize=(12, 5))\n\nfor i, var in enumerate(target_cols):\n    plt.plot(residuals[:sample_n, i], label=var)\n\nplt.title(\"Figure 4.17 Residual Analysis of Hybrid Model\")\nplt.xlabel(\"Test Sample\")\nplt.ylabel(\"Residual\")\nplt.legend()\nplt.tight_layout()\n\nplt.savefig(f\"{FIG_DIR}/Figure_4_17_Residual_Analysis_Hybrid_Model.png\", dpi=300)\nplt.show()\n\n# ============================================================\n# 9. Scatter Plot Figure 4.18\n# ============================================================\n\nplt.figure(figsize=(8, 6))\n\nfor i, var in enumerate(target_cols):\n    plt.scatter(y_test_inv[:, i], best_pred[:, i], alpha=0.25, label=var)\n\nplt.title(\"Figure 4.18 Scatter Plot of Actual vs Predicted Values\")\nplt.xlabel(\"Actual Values\")\nplt.ylabel(\"Predicted Values\")\nplt.legend()\nplt.tight_layout()\n\nplt.savefig(f\"{FIG_DIR}/Figure_4_18_Scatter_Actual_vs_Predicted.png\", dpi=300)\nplt.show()\n\n# ============================================================\n# 10. Statistical Significance Test Table 4.6\n# ============================================================\n\nhybrid_pred = predictions[\"Hybrid_LSTM_Transformer\"]\n\nstat_rows = []\n\nfor model_name in [\"LSTM\", \"Transformer\"]:\n\n    pred = predictions[model_name]\n\n    for i, var in enumerate(target_cols):\n\n        err_model = np.abs(y_test_inv[:, i] - pred[:, i])\n        err_hybrid = np.abs(y_test_inv[:, i] - hybrid_pred[:, i])\n\n        stat, p_value = ttest_rel(err_model, err_hybrid)\n\n        stat_rows.append({\n            \"Comparison\": f\"{model_name} vs Hybrid LSTM-Transformer\",\n            \"Variable\": var,\n            \"t_statistic\": stat,\n            \"p_value\": p_value,\n            \"Significant\": \"Yes\" if p_value < 0.05 else \"No\"\n        })\n\nstat_df = pd.DataFrame(stat_rows)\nstat_df.to_csv(f\"{TABLE_DIR}/Table_4_6_Statistical_Significance_Test.csv\", index=False)\n\nprint(\"\\n================ STATISTICAL TEST ================\\n\")\nprint(stat_df)\n\n# ============================================================\n# 11. SHAP Explainability Figures 4.19–4.21\n# ============================================================\n\ntry:\n    import shap\n\n    print(\"\\nRunning SHAP Explainability...\")\n\n    shap_sample_size = min(100, len(X_test))\n    background_size = min(50, len(X_train))\n\n    X_shap = X_test[:shap_sample_size]\n    background = X_train[:background_size]\n\n    explainer = shap.GradientExplainer(models[\"Hybrid_LSTM_Transformer\"], background)\n    shap_values = explainer.shap_values(X_shap)\n\n    if isinstance(shap_values, list):\n        shap_array = np.array(shap_values)\n        shap_mean = np.mean(np.abs(shap_array), axis=0)\n    else:\n        shap_mean = np.abs(shap_values)\n\n    # Some SHAP versions return extra output dimension\n    if shap_mean.ndim == 4:\n        shap_mean = shap_mean.mean(axis=-1)\n\n    feature_importance = shap_mean.mean(axis=(0, 1))\n\n    shap_importance_df = pd.DataFrame({\n        \"Feature\": feature_cols,\n        \"Mean_ABS_SHAP\": feature_importance\n    }).sort_values(\"Mean_ABS_SHAP\", ascending=False)\n\n    shap_importance_df.to_csv(\n        f\"{TABLE_DIR}/Table_4_7_SHAP_Feature_Importance_Ranking.csv\",\n        index=False\n    )\n\n    # Figure 4.19\n    plt.figure(figsize=(10, 6))\n    plt.bar(shap_importance_df[\"Feature\"], shap_importance_df[\"Mean_ABS_SHAP\"])\n    plt.title(\"Figure 4.19 SHAP Global Feature Importance\")\n    plt.xlabel(\"Feature\")\n    plt.ylabel(\"Mean |SHAP Value|\")\n    plt.xticks(rotation=30)\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/Figure_4_19_SHAP_Global_Feature_Importance.png\", dpi=300)\n    plt.show()\n\n    # Figure 4.20 Temporal SHAP\n    temporal_importance = shap_mean.mean(axis=(0, 2))\n\n    plt.figure(figsize=(10, 5))\n    plt.bar(range(1, SEQ_LEN + 1), temporal_importance)\n    plt.title(\"Figure 4.20 Temporal SHAP Importance\")\n    plt.xlabel(\"Historical Day Position\")\n    plt.ylabel(\"Mean |SHAP Value|\")\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/Figure_4_20_Temporal_SHAP_Importance.png\", dpi=300)\n    plt.show()\n\n    # Figure 4.21 Temporal SHAP Heatmap\n    temporal_feature_importance = shap_mean.mean(axis=0)\n\n    plt.figure(figsize=(12, 6))\n    plt.imshow(temporal_feature_importance.T, aspect=\"auto\", cmap=\"viridis\")\n    plt.colorbar(label=\"Mean |SHAP Value|\")\n    plt.yticks(range(len(feature_cols)), feature_cols)\n    plt.xticks(range(0, SEQ_LEN, 5), range(1, SEQ_LEN + 1, 5))\n    plt.xlabel(\"Historical Day Position\")\n    plt.ylabel(\"Feature\")\n    plt.title(\"Figure 4.21 Temporal SHAP Heatmap\")\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/Figure_4_21_Temporal_SHAP_Heatmap.png\", dpi=300)\n    plt.show()\n\nexcept Exception as e:\n\n    print(\"\\nSHAP failed. Using fallback permutation importance.\")\n    print(e)\n\n    baseline_pred = models[\"Hybrid_LSTM_Transformer\"].predict(X_test[:500])\n    baseline_mse = mean_squared_error(y_test[:500], baseline_pred)\n\n    temporal_scores = []\n\n    for t in range(SEQ_LEN):\n        X_perm = X_test[:500].copy()\n        np.random.shuffle(X_perm[:, t, :])\n\n        perm_pred = models[\"Hybrid_LSTM_Transformer\"].predict(X_perm)\n        perm_mse = mean_squared_error(y_test[:500], perm_pred)\n\n        temporal_scores.append(perm_mse - baseline_mse)\n\n    fallback_df = pd.DataFrame({\n        \"Day_Position\": range(1, SEQ_LEN + 1),\n        \"Importance\": temporal_scores\n    })\n\n    fallback_df.to_csv(\n        f\"{TABLE_DIR}/Fallback_Temporal_Importance.csv\",\n        index=False\n    )\n\n    plt.figure(figsize=(10, 5))\n    plt.bar(range(1, SEQ_LEN + 1), temporal_scores)\n    plt.title(\"Figure 4.20 Fallback Temporal Importance\")\n    plt.xlabel(\"Historical Day Position\")\n    plt.ylabel(\"Increase in MSE\")\n    plt.tight_layout()\n\n    plt.savefig(f\"{FIG_DIR}/Figure_4_20_Fallback_Temporal_Importance.png\", dpi=300)\n    plt.show()\n\n# ============================================================\n# 12. Agriculture Risk Figures 4.22–4.23 + Table 4.8\n# ============================================================\n\nrisk_df = pd.DataFrame(best_pred, columns=[f\"PRED_{c}\" for c in target_cols])\n\nrisk_df[\"Heatwave\"] = risk_df[\"PRED_TEMPERATURE\"] > 35\nrisk_df[\"Heavy_Rain\"] = risk_df[\"PRED_PRECIPITATION\"] > 20\nrisk_df[\"High_Wind\"] = risk_df[\"PRED_WIND_SPEED\"] > 10\nrisk_df[\"Drought_Risk\"] = (\n    (risk_df[\"PRED_HUMIDITY\"] < 15) &\n    (risk_df[\"PRED_PRECIPITATION\"] < 2)\n)\n\ndef agriculture_risk(row):\n    score = 0\n    if row[\"Heatwave\"]:\n        score += 1\n    if row[\"Heavy_Rain\"]:\n        score += 1\n    if row[\"High_Wind\"]:\n        score += 1\n    if row[\"Drought_Risk\"]:\n        score += 1\n\n    if score == 0:\n        return \"Low\"\n    elif score == 1:\n        return \"Medium\"\n    else:\n        return \"High\"\n\nrisk_df[\"Agriculture_Risk\"] = risk_df.apply(agriculture_risk, axis=1)\n\nrisk_df.to_csv(\n    f\"{TABLE_DIR}/Agriculture_Risk_Predictions.csv\",\n    index=False\n)\n\nrisk_summary = pd.DataFrame({\n    \"Risk_Level\": risk_df[\"Agriculture_Risk\"].value_counts().index,\n    \"Count\": risk_df[\"Agriculture_Risk\"].value_counts().values\n})\n\nrisk_summary.to_csv(\n    f\"{TABLE_DIR}/Table_4_8_Agricultural_Risk_Assessment_Summary.csv\",\n    index=False\n)\n\n# Figure 4.22\nplt.figure(figsize=(8, 5))\nplt.bar(risk_summary[\"Risk_Level\"], risk_summary[\"Count\"])\nplt.title(\"Figure 4.22 Agricultural Risk Level Distribution\")\nplt.xlabel(\"Risk Level\")\nplt.ylabel(\"Count\")\nplt.tight_layout()\n\nplt.savefig(f\"{FIG_DIR}/Figure_4_22_Agricultural_Risk_Level_Distribution.png\", dpi=300)\nplt.show()\n\nevent_counts = {\n    \"Heatwave\": int(risk_df[\"Heatwave\"].sum()),\n    \"Heavy Rain\": int(risk_df[\"Heavy_Rain\"].sum()),\n    \"High Wind\": int(risk_df[\"High_Wind\"].sum()),\n    \"Drought Risk\": int(risk_df[\"Drought_Risk\"].sum())\n}\n\nevent_df = pd.DataFrame({\n    \"Event\": list(event_counts.keys()),\n    \"Count\": list(event_counts.value