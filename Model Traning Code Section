zipfile, warnings\nwarnings.filterwarnings(\"ignore\")\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.preprocessing import MinMaxScaler\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nfrom scipy.stats import ttest_rel\n\nimport tensorflow as tf\nfrom tensorflow.keras.models import Model, Sequential\nfrom tensorflow.keras.layers import (\n    Input, LSTM, Dense, Dropout, LayerNormalization,\n    MultiHeadAttention, GlobalAveragePooling1D\n)\nfrom tensorflow.keras.optimizers import Adam\nfrom tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n\n# =========================\n# 1. Paths\n# =========================\n\nDATA_PATH = \"/kaggle/input/datasets/mdforhadmia/daily-weather-data/daily_weather_data.csv\"\n\nOUT_DIR = \"/kaggle/working/WeatherXAI_BD_Optimized_V3\"\nFIG_DIR = f\"{OUT_DIR}/figures\"\nTABLE_DIR = f\"{OUT_DIR}/tables\"\nMODEL_DIR = f\"{OUT_DIR}/models\"\n\nfor d in [OUT_DIR, FIG_DIR, TABLE_DIR, MODEL_DIR]:\n    os.makedirs(d, exist_ok=True)\n\n# =========================\n# 2. Load Dataset\n# =========================\n\ndf = pd.read_csv(DATA_PATH)\ndf.columns = df.columns.str.upper().str.strip()\ndf = df.loc[:, ~df.columns.duplicated()]\n\ntarget_cols_original = [\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION\"]\n\nrequired_cols = [\"DAY\", \"MONTH\", \"YEAR\", \"LAT\", \"LON\"] + target_cols_original\n\nfor col in required_cols:\n    if col not in df.columns:\n        raise ValueError(f\"Missing column: {col}\")\n\ndf[\"DATE\"] = pd.to_datetime(df[[\"YEAR\", \"MONTH\", \"DAY\"]])\ndf = df.sort_values([\"LAT\", \"LON\", \"DATE\"]).reset_index(drop=True)\n\ndf[target_cols_original] = df[target_cols_original].interpolate()\ndf[target_cols_original] = df[target_cols_original].fillna(method=\"ffill\").fillna(method=\"bfill\")\n\n# =========================\n# 3. Log Transform Precipitation\n# =========================\n\ndf[\"PRECIPITATION_LOG\"] = np.log1p(df[\"PRECIPITATION\"])\n\ntarget_cols = [\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION_LOG\"]\n\n# =========================\n# 4. Cyclical Encoding\n# =========================\n\ndf[\"MONTH_SIN\"] = np.sin(2 * np.pi * df[\"MONTH\"] / 12)\ndf[\"MONTH_COS\"] = np.cos(2 * np.pi * df[\"MONTH\"] / 12)\n\ndf[\"DAY_SIN\"] = np.sin(2 * np.pi * df[\"DAY\"] / 31)\ndf[\"DAY_COS\"] = np.cos(2 * np.pi * df[\"DAY\"] / 31)\n\n# =========================\n# 5. Lag + Rolling Features\n# =========================\n\nbase_weather_cols = [\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION_LOG\"]\n\nlag_days = [1, 7]\nrolling_windows = [7]\n\nfor col in base_weather_cols:\n    for lag in lag_days:\n        df[f\"{col}_LAG_{lag}\"] = df.groupby([\"LAT\", \"LON\"])[col].shift(lag)\n\n    for window in rolling_windows:\n        df[f\"{col}_ROLL_MEAN_{window}\"] = (\n            df.groupby([\"LAT\", \"LON\"])[col]\n            .rolling(window)\n            .mean()\n            .reset_index(level=[0, 1], drop=True)\n        )\n\n        df[f\"{col}_ROLL_STD_{window}\"] = (\n            df.groupby([\"LAT\", \"LON\"])[col]\n            .rolling(window)\n            .std()\n            .reset_index(level=[0, 1], drop=True)\n        )\n\ndf = df.dropna().reset_index(drop=True)\n\n# =========================\n# 6. Feature Columns\n# =========================\n\nfeature_cols = (\n    base_weather_cols +\n    [\"MONTH_SIN\", \"MONTH_COS\", \"DAY_SIN\", \"DAY_COS\"] +\n    [col for col in df.columns if \"LAG\" in col or \"ROLL\" in col]\n)\n\nprint(\"Total Features:\", len(feature_cols))\nprint(feature_cols)\n\n# =========================\n# 7. Save Tables\n# =========================\n\ndf[target_cols_original].describe().T.to_csv(f\"{TABLE_DIR}/descriptive_statistics_original.csv\")\ndf[target_cols_original].corr().to_csv(f\"{TABLE_DIR}/correlation_matrix_original.csv\")\n\n# Correlation heatmap original variables\ncorr = df[target_cols_original].corr()\n\nplt.figure(figsize=(8, 6))\nplt.imshow(corr, cmap=\"viridis\")\nplt.colorbar()\nplt.xticks(range(len(target_cols_original)), target_cols_original, rotation=30)\nplt.yticks(range(len(target_cols_original)), target_cols_original)\n\nfor i in range(len(target_cols_original)):\n    for j in range(len(target_cols_original)):\n        plt.text(j, i, f\"{corr.iloc[i, j]:.3f}\", ha=\"center\", va=\"center\", color=\"white\")\n\nplt.title(\"Correlation Heatmap of Weather Variables\")\nplt.tight_layout()\nplt.savefig(f\"{FIG_DIR}/correlation_heatmap.png\", dpi=300)\nplt.show()\n\n# =========================\n# 8. Scaling\n# =========================\n\ndf = df.sort_values([\"LAT\", \"LON\", \"DATE\"]).reset_index(drop=True)\n\nsplit_row = int(len(df) * 0.8)\n\ntrain_df = df.iloc[:split_row].copy()\ntest_df = df.iloc[split_row:].copy()\n\nfeature_scaler = MinMaxScaler()\ntarget_scaler = MinMaxScaler()\n\nfeature_scaler.fit(train_df[feature_cols])\ntarget_scaler.fit(train_df[target_cols])\n\ndf_scaled = df.copy()\ndf_scaled[feature_cols] = feature_scaler.transform(df[feature_cols])\ndf_scaled[target_cols] = target_scaler.transform(df[target_cols])\n\n# =========================\n# 9. Location-wise Sequence\n# =========================\n\nSEQ_LEN = 30\n\ndef create_location_sequences(df_scaled, feature_cols, target_cols, seq_len):\n    X, y = [], []\n\n    for (lat, lon), group in df_scaled.groupby([\"LAT\", \"LON\"]):\n        group = group.sort_values(\"DATE\")\n\n        features = group[feature_cols].values\n        targets = group[target_cols].values\n\n        if len(group) <= seq_len:\n            continue\n\n        for i in range(len(group) - seq_len):\n            X.append(features[i:i + seq_len])\n            y.append(targets[i + seq_len])\n\n    return np.array(X), np.array(y)\n\nX, y = create_location_sequences(df_scaled, feature_cols, target_cols, SEQ_LEN)\n\nsplit = int(len(X) * 0.7)\n\nX_train, X_test = X[:split], X[split:]\ny_train, y_test = y[:split], y[split:]\n\nprint(\"X_train:\", X_train.shape)\nprint(\"X_test:\", X_test.shape)\nprint(\"y_train:\", y_train.shape)\nprint(\"y_test:\", y_test.shape)\n\npd.DataFrame({\n    \"Dataset\": [\"X_train\", \"X_test\", \"y_train\", \"y_test\"],\n    \"Shape\": [str(X_train.shape), str(X_test.shape), str(y_train.shape), str(y_test.shape)]\n}).to_csv(f\"{TABLE_DIR}/train_test_dimensions.csv\", index=False)\n\n# =========================\n# 10. Models\n# =========================\n\ndef build_lstm_model(seq_len, n_features, n_outputs):\n    model = Sequential([\n        LSTM(96, return_sequences=True, input_shape=(seq_len, n_features)),\n        Dropout(0.25),\n        LSTM(48),\n        Dropout(0.25),\n        Dense(64, activation=\"relu\"),\n        Dense(n_outputs)\n    ])\n    model.compile(optimizer=Adam(0.0005), loss=\"mse\")\n    return model\n\ndef transformer_encoder(inputs, head_size=32, num_heads=2, ff_dim=128, dropout=0.2):\n    attn = MultiHeadAttention(num_heads=num_heads, key_dim=head_size)(inputs, inputs)\n    attn = Dropout(dropout)(attn)\n    x = LayerNormalization(epsilon=1e-6)(inputs + attn)\n\n    ff = Dense(ff_dim, activation=\"relu\")(x)\n    ff = Dropout(dropout)(ff)\n    ff = Dense(inputs.shape[-1])(ff)\n\n    x = LayerNormalization(epsilon=1e-6)(x + ff)\n    return x\n\ndef build_transformer_model(seq_len, n_features, n_outputs):\n    inputs = Input(shape=(seq_len, n_features))\n\n    x = transformer_encoder(inputs, head_size=32, num_heads=2, ff_dim=128)\n    x = GlobalAveragePooling1D()(x)\n\n    x = Dense(64, activation=\"relu\")(x)\n    x = Dropout(0.25)(x)\n\n    outputs = Dense(n_outputs)(x)\n\n    model = Model(inputs, outputs)\n    model.compile(optimizer=Adam(0.0005), loss=\"mse\")\n    return model\n\ndef build_simple_hybrid_model(seq_len, n_features, n_outputs):\n    inputs = Input(shape=(seq_len, n_features))\n\n    x = LSTM(64, return_sequences=True)(inputs)\n    x = Dropout(0.25)(x)\n\n    x = transformer_encoder(x, head_size=32, num_heads=2, ff_dim=128, dropout=0.2)\n\n    x = GlobalAveragePooling1D()(x)\n\n    x = Dense(64, activation=\"relu\")(x)\n    x = Dropout(0.25)(x)\n\n    outputs = Dense(n_outputs)(x)\n\n    model = Model(inputs, outputs)\n    model.compile(optimizer=Adam(0.0005), loss=\"mse\")\n    return model\n\nn_features = X_train.shape[2]\nn_outputs = y_train.shape[1]\n\nmodels = {\n    \"LSTM\": build_lstm_model(SEQ_LEN, n_features, n_outputs),\n    \"Transformer\": build_transformer_model(SEQ_LEN, n_features, n_outputs),\n    \"Hybrid_LSTM_Transformer\": build_simple_hybrid_model(SEQ_LEN, n_features, n_outputs)\n}\n\n# =========================\n# 11. Training\n# =========================\n\nEPOCHS = 100\nBATCH_SIZE = 32\n\nearly_stop = EarlyStopping(\n    monitor=\"val_loss\",\n    patience=15,\n    restore_best_weights=True\n)\n\nreduce_lr = ReduceLROnPlateau(\n    monitor=\"val_loss\",\n    factor=0.5,\n    patience=5,\n    min_lr=1e-6\n)\n\nhistories = {}\ntraining_times = []\n\nfor name, model in models.items():\n    print(f\"\\nTraining {name}...\")\n    start = time.time()\n\n    history = model.fit(\n        X_train,\n        y_train,\n        validation_split=0.2,\n        epochs=EPOCHS,\n        batch_size=BATCH_SIZE,\n        callbacks=[early_stop, reduce_lr],\n        verbose=1\n    )\n\n    end = time.time()\n\n    histories[name] = history\n    training_times.append({\n        \"Model\": name,\n        \"Training_Time_Seconds\": end - start\n    })\n\n    model.save(f\"{MODEL_DIR}/{name}.h5\")\n\npd.DataFrame(training_times).to_csv(f\"{TABLE_DIR}/training_time.csv\", index=False)\n\n# Loss curves\nfor name, history in histories.items():\n    plt.figure(figsize=(8, 5))\n    plt.plot(history.history[\"loss\"], label=\"Training Loss\")\n    plt.plot(history.history[\"val_loss\"], label=\"Validation Loss\")\n    plt.title(f\"{name} Training and Validation Loss\")\n    plt.xlabel(\"Epoch\")\n    plt.ylabel(\"Loss\")\n    plt.legend()\n    plt.tight_layout()\n    plt.savefig(f\"{FIG_DIR}/{name}_loss_curve.png\", dpi=300)\n    plt.show()\n\n# =========================\n# 12. Inverse Transform Helper\n# =========================\n\ndef inverse_targets(y_scaled):\n    inv = target_scaler.inverse_transform(y_scaled)\n    out = pd.DataFrame(inv, columns=target_cols)\n\n    out[\"PRECIPITATION\"] = np.expm1(out[\"PRECIPITATION_LOG\"])\n    out = out.drop(columns=[\"PRECIPITATION_LOG\"])\n\n    return out[[\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION\"]].values\n\n# =========================\n# 13. Metrics\n# =========================\n\nfinal_target_cols = [\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION\"]\n\ny_test_inv = inverse_targets(y_test)\n\npredictions = {}\nresults = []\n\nfor name, model in models.items():\n    pred_scaled = model.predict(X_test)\n    pred_inv = inverse_targets(pred_scaled)\n\n    predictions[name] = pred_inv\n\n    for i, var in enumerate(final_target_cols):\n        mae = mean_absolute_error(y_test_inv[:, i], pred_inv[:, i])\n        mse = mean_squared_error(y_test_inv[:, i], pred_inv[:, i])\n        rmse = np.sqrt(mse)\n        r2 = r2_score(y_test_inv[:, i], pred_inv[:, i])\n\n        results.append({\n            \"Model\": name,\n            \"Variable\": var,\n            \"MAE\": mae,\n            \"MSE\": mse,\n            \"RMSE\": rmse,\n            \"R2\": r2\n        })\n\nmetrics_df = pd.DataFrame(results)\nmetrics_df.to_csv(f\"{TABLE_DIR}/optimized_v3_model_metrics.csv\", index=False)\n\nprint(\"\\nMetrics:\")\nprint(metrics_df)\n\navg_r2 = metrics_df.groupby(\"Model\")[\"R2\"].mean().sort_values(ascending=False)\nprint(\"\\nAverage R2:\")\nprint(avg_r2)\n\nbest_model_name = avg_r2.index[0]\nbest_pred = predictions[best_model_name]\n\n# =========================\n# 14. Graphs\n# =========================\n\nfor metric in [\"MAE\", \"RMSE\", \"R2\"]:\n    pivot = metrics_df.pivot(index=\"Variable\", columns=\"Model\", values=metric)\n\n    plt.figure(figsize=(10, 6))\n    pivot.plot(kind=\"bar\", figsize=(10, 6))\n    plt.title(f\"Optimized V3 Model Comparison Based on {metric}\")\n    plt.xlabel(\"Variable\")\n    plt.ylabel(metric)\n    plt.xticks(rotation=20)\n    plt.tight_layout()\n    plt.savefig(f\"{FIG_DIR}/optimized_v3_comparison_{metric}.png\", dpi=300)\n    plt.show()\n\nsample_n = min(500, len(y_test_inv))\n\nfor name, pred_inv in predictions.items():\n    for i, var in enumerate(final_target_cols):\n        plt.figure(figsize=(12, 5))\n        plt.plot(y_test_inv[:sample_n, i], label=\"Actual\")\n        plt.plot(pred_inv[:sample_n, i], label=\"Predicted\")\n        plt.title(f\"{name}: Actual vs Predicted {var}\")\n        plt.xlabel(\"Test Sample\")\n        plt.ylabel(var)\n        plt.legend()\n        plt.tight_layout()\n        plt.savefig(f\"{FIG_DIR}/{name}_actual_vs_predicted_{var}.png\", dpi=300)\n        plt.show()\n\n# =========================\n# 15. Statistical Test\n# =========================\n\nhybrid_pred = predictions[\"Hybrid_LSTM_Transformer\"]\n\nstat_rows = []\n\nfor model_name in [\"LSTM\", \"Transformer\"]:\n    pred = predictions[model_name]\n\n    for i, var in enumerate(final_target_cols):\n        err_model = np.abs(y_test_inv[:, i] - pred[:, i])\n        err_hybrid = np.abs(y_test_inv[:, i] - hybrid_pred[:, i])\n\n        stat, p_value = ttest_rel(err_model, err_hybrid)\n\n        stat_rows.append({\n            \"Comparison\": f\"{model_name} vs Hybrid\",\n            \"Variable\": var,\n            \"t_statistic\": stat,\n            \"p_value\": p_value,\n            \"Significant\": \"Yes\" if p_value < 0.05 else \"No\"\n        })\n\nstat_df = pd.DataFrame(stat_rows)\nstat_df.to_csv(f\"{TABLE_DIR}/optimized_v3_statistical_test.csv\", index=False)\nprint(\"\\nStatistical Test:\")\nprint(stat_df)\n\n# =========================\n# 16. Agriculture Risk\n# =========================\n\nrisk_df = pd.DataFrame(best_pred, columns=[f\"PRED_{c}\" for c in final_target_cols])\n\nrisk_df[\"Heatwave\"