= f\"{OUT_DIR}/tables\"\nMODEL_DIR = f\"{OUT_DIR}/models\"\n\nfor d in [OUT_DIR, FIG_DIR, TABLE_DIR, MODEL_DIR]:\n    os.makedirs(d, exist_ok=True)\n\n# =========================\n# 2. Load Dataset\n# =========================\n\ndf = pd.read_csv(DATA_PATH)\ndf.columns = df.columns.str.upper().str.strip()\ndf = df.loc[:, ~df.columns.duplicated()]\n\ntarget_cols = [\"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION\"]\nfeature_cols = [\"LAT\", \"LON\", \"DAY\", \"MONTH\", \"YEAR\"] + target_cols\n\nrequired_cols = [\"DAY\", \"MONTH\", \"YEAR\", \"LAT\", \"LON\"] + target_cols\n\nfor col in required_cols:\n    if col not in df.columns:\n        raise ValueError(f\"Missing column: {col}\")\n\ndf[\"DATE\"] = pd.to_datetime(df[[\"YEAR\", \"MONTH\", \"DAY\"]])\ndf = df.sort_values([\"DATE\", \"LAT\", \"LON\"]).reset_index(drop=True)\n\ndf[feature_cols] = df[feature_cols].interpolate()\ndf[feature_cols] = df[feature_cols].fillna(method=\"ffill\").fillna(method=\"bfill\")\n\nprint(\"Dataset shape:\", df.shape)\nprint(\"Missing values:\")\nprint(df[feature_cols].isnull().sum())\n\n# =========================\n# 3. Table 3.1 Dataset Attributes\n# =========================\n\ntable_3_1 = pd.DataFrame({\n    \"Attribute\": [\"DAY\", \"MONTH\", \"YEAR\", \"LAT\", \"LON\", \"HUMIDITY\", \"TEMPERATURE\", \"WIND_SPEED\", \"PRECIPITATION\"],\n    \"Description\": [\n        \"Day of observation\",\n        \"Month of observation\",\n        \"Year of observation\",\n        \"Latitude coordinate\",\n        \"Longitude coordinate\",\n        \"Relative humidity\",\n        \"Daily average air temperature\",\n        \"Daily average wind speed\",\n        \"Daily accumulated precipitation\"\n    ],\n    \"Unit\": [\"-\", \"-\", \"-\", \"Degree\", \"Degree\", \"%\", \"°C\", \"m/s\", \"mm/day\"]\n})\ntable_3_1.to_csv(f\"{TABLE_DIR}/Table_3_1_Dataset_Attributes.csv\", index=False)\n\n# =========================\n# 4. Table 3.2 Dataset Structure\n# =========================\n\ntable_3_2 = pd.DataFrame({\n    \"Item\": [\n        \"Total observations\",\n        \"Total attributes\",\n        \"Study period\",\n        \"Forecasting variables\",\n        \"Input features\",\n        \"Forecasting horizon\",\n        \"Sequence length\"\n    ],\n    \"Value\": [\n        df.shape[0],\n        df.shape[1],\n        \"2021–2024\",\n        \", \".join(target_cols),\n        \", \".join(feature_cols),\n        \"One-step ahead forecasting\",\n        \"30 days\"\n    ]\n})\ntable_3_2.to_csv(f\"{TABLE_DIR}/Table_3_2_Dataset_Structure.csv\", index=False)\n\n# =========================\n# 5. Table 3.3 Descriptive Statistics\n# =========================\n\ndesc_stats = df[target_cols].describe().T\ndesc_stats = desc_stats[[\"mean\", \"std\", \"min\", \"25%\", \"50%\", \"75%\", \"max\"]]\ndesc_stats.columns = [\"Mean\", \"Std. Dev.\", \"Minimum\", \"25%\", \"Median\", \"75%\", \"Maximum\"]\ndesc_stats = desc_stats.round(4)\ndesc_stats.to_csv(f\"{TABLE_DIR}/Table_3_3_Descriptive_Statistics.csv\")\n\n# =========================\n# 6. Table 3.4 Correlation Matrix + Figure 3.2\n# =========================\n\ncorr = df[target_cols].corr().round(4)\ncorr.to_csv(f\"{TABLE_DIR}/Table_3_4_Correlation_Matrix.csv\")\n\nplt.figure(figsize=(8, 6))\nplt.imshow(corr, cmap=\"viridis\")\nplt.colorbar()\nplt.xticks(range(len(target_cols)), target_cols, rotation=30)\nplt.yticks(range(len(target_cols)), target_cols)\nfor i in range(len(target_cols)):\n    for j in range(len(target_cols)):\n        plt.text(j, i, f\"{corr.iloc[i, j]:.3f}\", ha=\"center\", va=\"center\", color=\"white\")\nplt.title(\"Figure 3.2 Correlation Heatmap of Weather Variables\")\nplt.tight_layout()\nplt.savefig(f\"{FIG_DIR}/Figure_3_2_Correlation_Heatmap.png\", dpi=300)\nplt.show()\n\n# =========================\n# 7. Table 3.5 ADF Test\n# =========================\n\nadf_rows = []\nfor col in target_cols:\n    result = adfuller(df[col].dropna())\n    adf_rows.append({\n        \"Variable\": col,\n        \"ADF Statistic\": result[0],\n        \"p-value\": result[1],\n        \"Stationary\": \"Yes\" if result[1] < 0.05 else \"No\"\n    })\n\nadf_df = pd.DataFrame(adf_rows).round(6)\nadf_df.to_csv(f\"{TABLE_DIR}/Table_3_5_ADF_Test_Results.csv\", index=False)\n\n# =========================\n# 8. Figure 3.1 Research Framework\n# =========================\n\nplt.figure(figsize=(10, 12))\nsteps = [\n    \"Dataset Collection\",\n    \"Data Preprocessing\",\n    \"Correlation Analysis\",\n    \"ADF Stationarity Test\",\n    \"Min-Max Normalization\",\n    \"Sliding Window Generation\",\n    \"LSTM / Transformer / Hybrid\",\n    \"Forecasting\",\n    \"Evaluation Metrics\",\n    \"SHAP Explainability\",\n    \"Extreme Event Detection\",\n    \"Agricultural Risk Assessment\"\n]\nfor i, step in enumerate(steps):\n    y = len(steps) - i\n    plt.text(0.5, y, step, ha=\"center\", va=\"center\",\n             bbox=dict(boxstyle=\"round,pad=0.5\", fc=\"white\", ec=\"black\"), fontsize=11)\n    if i < len(steps) - 1:\n        plt.arrow(0.5, y - 0.25, 0, -0.45, head_width=0.03, head_length=0.1, fc=\"black\", ec=\"black\")\nplt.xlim(0, 1)\nplt.ylim(0, len(steps) + 1)\nplt.axis(\"off\")\nplt.title(\"Figure 3.1 Proposed WeatherXAI-BD Research Framework\")\nplt.tight_layout()\nplt.savefig(f\"{FIG_DIR}/Figure_3_1_Proposed_Research_Framework.png\", dpi=300)\nplt.show()\n\n# =========================\n# 9. Trend Figures 3.6–3.9\n# =========================\n\ndaily_avg = df.groupby(\"DATE\")[target_cols].mean().reset_index()\n\nfigure_map = {\n    \"TEMPERATURE\": \"Figure_3_6_Temperature_Trend_Analysis.png\",\n    \"HUMIDITY\": \"Figure_3_7_Humidity_Trend_Analysis.png\",\n    \"WIND_SPEED\": \"Figure_3_8_Wind_Speed_Trend_Analysis.png\",\n    \"PRECIPITATION\": \"Figure_3_9_Precipitation_Trend_Analysis.png\"\n}\n\nfor col, filename in figure_map.items():\n    plt.figure(figsize=(12, 5))\n    plt.plot(daily_avg[\"DATE\"], daily_avg[col])\n    plt.title(filename.replace(\"_\", \" \").replace(\".png\", \"\"))\n    plt.xlabel(\"Date\")\n    plt.ylabel(col)\n    plt.tight_layout()\n    plt.savefig(f\"{FIG_DIR}/{filename}\", dpi=300)\n    plt.show()\n\n# =========================\n# 10. Leakage-safe Normalization\n# =========================\n\ndata_features = df[feature_cols].values\ndata_targets = df[target_cols].values\n\nsplit_row = int(len(df) * 0.8)\n\nfeature_scaler = MinMaxScaler()\ntarget_scaler = MinMaxScaler()\n\ntrain_features = data_features[:split_row]\ntest_features = data_features[split_row:]\n\ntrain_targets = data_targets[:split_row]\ntest_targets = data_targets[split_row:]\n\ntrain_features_scaled = feature_scaler.fit_transform(train_features)\ntest_features_scaled = feature_scaler.transform(test_features)\n\ntrain_targets_scaled = target_scaler.fit_transform(train_targets)\ntest_targets_scaled = target_scaler.transform(test_targets)\n\nfeatures_scaled = np.vstack([train_features_scaled, test_features_scaled])\ntargets_scaled = np.vstack([train_targets_scaled, test_targets_scaled])\n\n# =========================\n# 11. Sliding Window\n# =========================\n\nSEQ_LEN = 30\n\ndef create_sequences(features, targets, seq_len):\n    X, y = [], []\n    for i in range(len(features) - seq_len):\n        X.append(features[i:i + seq_len])\n        y.append(targets[i + seq_len])\n    return np.array(X), np.array(y)\n\nX, y = create_sequences(features_scaled, targets_scaled, SEQ_LEN)\n\nsplit = int(len(X) * 0.8)\n\nX_train, X_test = X[:split], X[split:]\ny_train, y_test = y[:split], y[split:]\n\n# Table 3.6\ntable_3_6 = pd.DataFrame({\n    \"Dataset\": [\"X_train\", \"X_test\", \"y_train\", \"y_test\"],\n    \"Shape\": [str(X_train.shape), str(X_test.shape), str(y_train.shape), str(y_test.shape)]\n})\ntable_3_6.to_csv(f\"{TABLE_DIR}/Table_3_6_Train_Test_Dimensions.csv\", index=False)\n\n# Figure 3.10\nplt.figure(figsize=(10, 4))\nplt.plot(range(1, 31), np.ones(30), marker=\"o\", label=\"Input sequence: previous 30 days\")\nplt.scatter(31, 1, marker=\"s\", s=150, label=\"Target: next day\")\nplt.yticks([])\nplt.xlabel(\"Time Step\")\nplt.title(\"Figure 3.10 Sliding Window Sequence Generation\")\nplt.legend()\nplt.tight_layout()\nplt.savefig(f\"{FIG_DIR}/Figure_3_10_Sliding_Window_Sequence_Generation.png\", dpi=300)\nplt.show()\n\n# =========================\n# 12. Model Architectures\n# =========================\n\ndef build_lstm_model(seq_len, n_features, n_outputs):\n    model = Sequential([\n        LSTM(64, return_sequences=True, input_shape=(seq_len, n_features)),\n        Dropout(0.2),\n        LSTM(32),\n        Dropout(0.2),\n        Dense(64, activation=\"relu\"),\n        Dense(n_outputs)\n    ])\n    model.compile(optimizer=Adam(0.001), loss=\"mse\")\n    return model\n\ndef transformer_encoder(inputs, head_size=64, num_heads=4, ff_dim=128, dropout=0.2):\n    attn = MultiHeadAttention(num_heads=num_heads, key_dim=head_size)(inputs, inputs)\n    attn = Dropout(dropout)(attn)\n    x = LayerNormalization(epsilon=1e-6)(inputs + attn)\n\n    ff = Dense(ff_dim, activation=\"relu\")(x)\n    ff = Dropout(dropout)(ff)\n    ff = Dense(inputs.shape[-1])(ff)\n\n    x = LayerNormalization(epsilon=1e-6)(x + ff)\n    return x\n\ndef build_transformer_model(seq_len, n_features, n_outputs):\n    inputs = Input(shape=(seq_len, n_features))\n    x = transformer_encoder(inputs)\n    x = transformer_encoder(x)\n    x = GlobalAveragePooling1D()(x)\n    x = Dense(64, activation=\"relu\")(x)\n    x = Dropout(0.2)(x)\n    outputs = Dense(n_outputs)(x)\n    model = Model(inputs, outputs)\n    model.compile(optimizer=Adam(0.001), loss=\"mse\")\n    return model\n\ndef build_hybrid_model(seq_len, n_features, n_outputs):\n    inputs = Input(shape=(seq_len, n_features))\n    x = LSTM(64, return_sequences=True)(inputs)\n    x = Dropout(0.2)(x)\n    x = LSTM(32, return_sequences=True)(x)\n    x = transformer_encoder(x, head_size=32, num_heads=4, ff_dim=128, dropout=0.2)\n    x = GlobalAveragePooling1D()(x)\n    x = Dense(64, activation=\"relu\")(x)\n    x = Dropout(0.2)(x)\n    outputs = Dense(n_outputs)(x)\n    model = Model(inputs, outputs)\n    model.compile(optimizer=Adam(0.001), loss=\"mse\")\n    return model\n\nn_features = X_train.shape[2]\nn_outputs = y_train.shape[1]\n\nmodels = {\n    \"LSTM\": build_lstm_model(SEQ_LEN, n_features, n_outputs),\n    \"Transformer\": build_transformer_model(SEQ_LEN, n_features, n_outputs),\n    \"Hybrid_LSTM_Transformer\": build_hybrid_model(SEQ_LEN, n_features, n_outputs)\n}\n\n# Save model architecture figures\nplot_model(models[\"LSTM\"], to_file=f\"{FIG_DIR}/Figure_3_3_LSTM_Architecture.png\", show_shapes=True, show_layer_names=True)\nplot_model(models[\"Transformer\"], to_file=f\"{FIG_DIR}/Figure_3_4_Transformer_Architecture.png\", show_shapes=True, show_layer_names=True)\nplot_model(models[\"Hybrid_LSTM_Transformer\"], to_file=f\"{FIG_DIR}/Figure_3_5_Hybrid_LSTM_Transformer_Architecture.png\", show_shapes=True, show_layer_names=True)\n\n# =========================\n# 13. Hyperparameter Tables\n# =========================\n\npd.DataFrame({\n    \"Parameter\": [\"Sequence Length\", \"LSTM Units\", \"Dropout\", \"Dense Units\", \"Optimizer\", \"Learning Rate\"],\n    \"Value\": [SEQ_LEN, \"64, 32\", 0.2, 64, \"Adam\", 0.001]\n}).to_csv(f\"{TABLE_DIR}/Table_3_7_LSTM_Hyperparameters.csv\", index=False)\n\npd.DataFrame({\n    \"Parameter\": [\"Sequence Length\", \"Attention Heads\", \"Head Size\", \"Feed Forward Dimension\", \"Dropout\", \"Optimizer\", \"Learning Rate\"],\n    \"Value\": [SEQ_LEN, 4, 64, 128, 0.2, \"Adam\", 0.001]\n}).to_csv(f\"{TABLE_DIR}/Table_3_8_Transformer_Hyperparameters.csv\", index=False)\n\npd.DataFrame({\n    \"Parameter\": [\"Sequence Length\", \"LSTM Units\", \"Attention Heads\", \"Head Size\", \"Feed Forward Dimension\", \"Dropout\", \"Optimizer\", \"Learning Rate\"],\n    \"Value\": [SEQ_LEN, \"64, 32\", 4, 32, 128, 0.2, \"Adam\", 0.001]\n}).to_csv(f\"{TABLE_DIR}/Table_3_9_Hybrid_Hyperparameters.csv\", index=False)\n\nEPOCHS = 50\nBATCH_SIZE = 32\n\npd.DataFrame({\n    \"Parameter\": [\"Epochs\", \"Batch Size\", \"Validation Split\", \"Early Stopping Patience\", \"Loss Function\"],\n    \"Value\": [EPOCHS, BATCH_SIZE, 0.2, 8, \"Mean Squared Error\"]\n}).to_csv(f\"{TABLE_DIR}/Table_3_10_Training_Configuration.csv\", index=False)\n\npd.DataFrame({\n    \"Software\": [\"Python\", \"TensorFlow\", \"Pandas\", \"NumPy\", \"Matplotlib\", \"Scikit-learn\"],\n    \"Version\": [platform.python_version(), tf.__version__, pd.__version__, np.__version__, \"Installed\", \"Installed\"]\n}).to_csv(f\"{TABLE_DIR}/Table_3_11_Software_Environment.csv\", index=False)\n\npd.DataFrame({\n    \"Hardware\": [\"Platform\", \"Processor\"],\n    \"Information\": [platform.platform(), platform.processor()]\n}).to_csv(f\"{TABLE_DIR}/Table_3_12_Hardware_Environment.csv\", index=False)\n\npd.DataFrame({\n    \"Configuration\": [\"Observation Count\", \"Input Features\", \"Target Variables\", \"Train Split\", \"Test Split\"],\n    \"Value\": [df.shape[0], len(feature_cols), len(target_cols), \"80%\", \"20%\"]\n}).to_csv(f\"{TABLE_DIR}/Table_3_13_Dataset_Configuration.csv\", index=False)\n\npd.DataFrame({\n    \"Model\": [\"LSTM\", \"Transformer\", \"Hybrid LSTM-Transformer\"],\n    \"Trainable\": [\"Yes\", \"Yes\", \"Yes\"],\n    \"Output Variables\": [\", \".join(target_cols)] * 3\n}).to_csv(f\"{TABLE_DIR}/Table_3_14_Model_Training_Configuration.csv\", index=False)\n\n# =========================\n# 14. Training\n# =========================\n\nearly_stop = EarlyStopping(\n    monitor=\"val_loss\",\n    patience=8,\n    restore_best_weights=True\n)\n\nhistories = {}\ntraining_times = []\n\nfor name, model in models.items():\n    print(f\"\\nTraining {name}...\")\n    start = time.time()\n    history = model.fit(\n        X_train, y_train,\n        validation_split=0.2,\n        epochs=EPOCHS,\n        batch_size=BATCH_SIZE,\n        callbacks=[early_stop],\n        verbose=1\n    )\n    end =